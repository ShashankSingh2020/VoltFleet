# Django Core
DJANGO_SECRET_KEY=change-in-production-use-a-strong-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Database Configuration (Docker Compose port is 5435; native local is 5432)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/voltfleet
DB_NAME=voltfleet
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis & Channels (Docker Compose port is 6380; native local is 6379)
REDIS_URL=redis://127.0.0.1:6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini Copilot
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
